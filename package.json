{
  "name": "cyberpunk-tcg-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Consultation des cotes Cardmarket du Cyberpunk TCG (WeirdCo)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/fetch-cardmarket.mjs",
    "data:cardmarket": "node scripts/build-dataset.mjs",
    "data:refresh": "npm run data:fetch && npm run data:cardmarket",
    "data:netdeck": "node scripts/netdeck-export.mjs",
    "data:netdeck:images": "node scripts/netdeck-export.mjs --images"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0"
  }
}
